# Reference defaults only. Stage 1 does not automatically load .env files.
# Set these variables in your shell before running Jarvis.
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=data
JARVIS_LOG_DIR=logs
# Optional Stage 5 only; never put a real credential in this file.
GEMINI_API_KEY=
# Omit JARVIS_GEMINI_MODEL to use config.settings.DEFAULT_GEMINI_MODEL.
JARVIS_AI_TIMEOUT_SECONDS=30
